/*
 * chain.ct - the OO and chaining contract.
 *
 * Every assertion here is one of the C1 items: the setter returns the very
 * receiver (`==` identity), the builder returns the node, and the three legal
 * ways to start a chain (variable, literal, call result) each stay on one
 * line. The one form the compiler rejects -- a method call on a temporary
 * inside a larger expression -- is exercised by tests/compile_fail.
 *
 * License: MIT (see LICENSE).
 */

#include <stdio.h>

import cJSON::JsonTypes;
import cJSON::Json;

int passed = 0;
int failed = 0;

void check(int cond, const char *name)
{
    if (cond) {
        passed = passed + 1;
    } else {
        failed = failed + 1;
        printf("FAIL %s\n", name);
    }
}

int main(void)
{
    JsonDoc *d;
    JsonNode *o;
    JsonNode *a;
    JsonNode *n;
    JsonNode *ord;
    char buf[128];
    int st;

    /* ---- C1.3 / C1.5: every config setter returns the receiver itself ---- */
    d = cJSON::Lib.newDoc();
    check(d.setMaxDepth(10) == d, "setMaxDepth returns the receiver");
    check(d.setMaxNodes(100) == d, "setMaxNodes returns the receiver");
    check(d.setMaxString(1000) == d, "setMaxString returns the receiver");
    check(d.setMaxInput(10000) == d, "setMaxInput returns the receiver");

    /* ---- C1.7: a four-segment config chain ending in parse ---- */
    check(d.setMaxDepth(64).setMaxNodes(100000).setMaxString(1024).setMaxInput(4096)
              .parse("{\"a\":[1,2]}") == JSON_OK,
          "four-segment config chain ends in parse");
    check(d.root().childByKey("a").childCount() == 2, "the chain parsed the tree");
    d.drop();

    /* ---- C1.6: starting form 1, a variable receiver ---- */
    d = cJSON::Lib.newDoc();
    check(d.setMaxDepth(8).parse("[1]") == JSON_OK, "variable receiver chain");
    d.drop();

    /* ---- C1.6: starting form 2, a literal receiver ---- */
    d = "{\"a\":1}".toDoc();
    check(d != 0 && d.root().childByKey("a").numberValue() == 1.0,
          "literal receiver chain");
    d.drop();

    /* ---- C1.6: starting form 3, a namespace-call receiver ---- */
    d = cJSON::Lib.newDoc().setMaxDepth(16);
    check(d != 0, "call-result receiver chain");
    check(d.parse("[true]") == JSON_OK, "the call-result chain is usable");
    d.drop();

    /* ---- C1.4: builders return the node they were called on ---- */
    o = cJSON::Lib.newObject();
    check(o != 0 && o.kind() == JSON_OBJECT, "newObject");
    check(o.put("a", cJSON::Lib.newNumber(1)) == o, "put returns the receiver");
    check(o.put("b", cJSON::Lib.newBool(1)) == o, "put returns the receiver again");
    check(o.childCount() == 2, "put added both members");

    a = cJSON::Lib.newArray();
    check(a != 0 && a.kind() == JSON_ARRAY, "newArray");
    check(a.append(cJSON::Lib.newString("x")) == a, "append returns the receiver");
    check(a.append(cJSON::Lib.newNull()) == a, "append returns the receiver again");
    check(a.childCount() == 2, "append added both elements");

    n = o.put("list", a);
    check(n == o, "put of a subtree keeps the chain");
    check(o.childByKey("list").childCount() == 2, "the subtree moved in");

    /* ---- C5.2: append preserves insertion order ---- */
    ord = cJSON::Lib.newArray().append(cJSON::Lib.newNumber(3))
              .append(cJSON::Lib.newBool(1)).append(cJSON::Lib.newNull());
    check(ord.childAt(0).kind() == JSON_NUMBER &&
          ord.childAt(1).kind() == JSON_TRUE &&
          ord.childAt(2).kind() == JSON_NULL,
          "append preserves insertion order");
    d = cJSON::Lib.newDoc().setRoot(ord);
    d.drop();

    /* ---- C5.5: a null string is rejected, not dereferenced ---- */
    check(cJSON::Lib.newString(0) == 0, "newString(0) returns 0");

    /* ---- put replaces an existing member instead of duplicating it ---- */
    check(o.put("a", cJSON::Lib.newNumber(2)) == o, "put over an existing key chains");
    check(o.childByKey("a").numberValue() == 2.0, "put replaced the value");
    check(o.childCount() == 3, "put did not add a duplicate member");

    /* ---- C1.4: a build chain hands the tree to a doc ---- */
    d = cJSON::Lib.newDoc();
    check(d.setRoot(o) == d, "setRoot returns the receiver");
    check(d.root() == o, "setRoot adopts the caller's tree");
    st = d.writeBuf(buf, 128, 0);
    check(st > 0 && buf[0] == '{', "the adopted tree renders");
    check(d.write(0) != 0, "write renders the adopted tree");
    d.drop();

    /* ---- put / append guards return 0 and consume nothing ---- */
    o = cJSON::Lib.newObject();
    a = cJSON::Lib.newArray();
    n = cJSON::Lib.newNull();
    check(o.put("x", 0) == 0, "put with a null child returns 0");
    check(o.append(n) == 0, "append on an object returns 0");
    check(a.append(n) == a, "the rejected child is still the caller's");
    check(a.append(0) == 0, "append with a null child returns 0");
    d = cJSON::Lib.newDoc().setRoot(a);
    check(d.root().put("k", d.root()) == 0, "put on an array returns 0");
    check(d.root().childCount() == 1, "the rejected put left the array alone");
    d.drop();

    /* the empty object still needs an owner */
    d = cJSON::Lib.newDoc().setRoot(o);
    check(d.root() == o, "an empty built object is owned by a doc");
    /* C5.7: setRoot(0) drops the tree and leaves an empty doc */
    check(d.setRoot(0) == d, "setRoot(0) returns the receiver");
    check(d.root() == 0, "setRoot(0) clears the root");
    check(d.writeBuf(buf, 8, 0) == -1, "writeBuf after setRoot(0) returns -1");
    d.drop();

    printf("SUMMARY passed=%d failed=%d\n", passed, failed);
    return failed == 0 ? 0 : 1;
}
